---
import Layout from '../../layouts/Layout.astro';
import { rooms } from '../../data/apartment';

export async function getStaticPaths() {
  return rooms.map((room) => ({
    params: { room: room.id },
    props: { room },
  }));
}

const { room } = Astro.props;
---

<Layout title={room.name} description={`Inside the ${room.name.toLowerCase()}.`}>
  <section class="max-w-5xl mx-auto px-6 py-10">
    <a href="/" class="text-sm hover:underline" style="color: var(--color-ink-soft);">
      ← floor plan
    </a>

    <div class="mt-4 mb-8" transition:name={`room-${room.id}`}>
      <h1 class="font-serif text-3xl md:text-4xl" style="color: var(--color-ink);">
        {room.name}
      </h1>
    </div>

    <div class="w-full overflow-x-auto">
      <svg viewBox="0 0 900 600" class="w-full h-auto" style="min-width: 640px;">
        <rect x="0" y="0" width="900" height="600" fill="var(--color-paper)" />

        {room.id === 'entry' && (
          <g stroke="var(--color-ink)" stroke-width="2" fill="none">
            <rect x="60" y="80" width="780" height="440" stroke="var(--color-line)" />
            <ellipse cx="450" cy="320" rx="180" ry="60" stroke="var(--color-line)" stroke-dasharray="4 4" />
            <rect x="70" y="240" width="140" height="140" fill="var(--color-paper)" />
            <line x1="70" y1="270" x2="210" y2="270" stroke="var(--color-line)" />
            <line x1="70" y1="310" x2="210" y2="310" stroke="var(--color-line)" />
            <line x1="70" y1="350" x2="210" y2="350" stroke="var(--color-line)" />
          </g>
        )}

        {room.id === 'living-dining' && (
          <g stroke="var(--color-ink)" stroke-width="2" fill="none">
            <rect x="80" y="240" width="220" height="90" rx="14" />
            <rect x="220" y="300" width="120" height="70" fill="var(--color-paper)" />
            <ellipse cx="200" cy="420" rx="150" ry="70" stroke="var(--color-line)" stroke-dasharray="4 4" />
            <rect x="550" y="230" width="180" height="90" />
            <rect x="560" y="200" width="24" height="30" />
            <rect x="680" y="200" width="24" height="30" />
            <rect x="560" y="320" width="24" height="30" />
            <rect x="680" y="320" width="24" height="30" />
          </g>
        )}

        {room.id === 'working-area' && (
          <g stroke="var(--color-ink)" stroke-width="2" fill="none">
            <rect x="120" y="380" width="260" height="80" />
            <rect x="150" y="460" width="40" height="70" />
            <rect x="150" y="60" width="220" height="260" fill="var(--color-paper)" />
            <line x1="150" y1="120" x2="370" y2="120" stroke="var(--color-line)" />
            <line x1="150" y1="180" x2="370" y2="180" stroke="var(--color-line)" />
            <line x1="150" y1="240" x2="370" y2="240" stroke="var(--color-line)" />
            <line x1="150" y1="300" x2="370" y2="300" stroke="var(--color-line)" />
          </g>
        )}

        {room.id === 'kitchen' && (
          <g stroke="var(--color-ink)" stroke-width="2" fill="none">
            <path d="M 60 60 H 500 V 180 H 60 Z" />
            <rect x="300" y="60" width="120" height="120" fill="var(--color-paper)" />
            <rect x="60" y="330" width="200" height="240" fill="var(--color-paper)" />
            <line x1="60" y1="410" x2="260" y2="410" stroke="var(--color-line)" />
            <line x1="60" y1="490" x2="260" y2="490" stroke="var(--color-line)" />
            <rect x="560" y="330" width="220" height="240" />
            <rect x="600" y="330" width="60" height="200" fill="var(--color-paper)" />
          </g>
        )}

        {room.id === 'bedroom' && (
          <g stroke="var(--color-ink)" stroke-width="2" fill="none">
            <rect x="480" y="180" width="300" height="220" rx="8" />
            <rect x="500" y="180" width="70" height="40" rx="6" />
            <rect x="710" y="180" width="70" height="40" rx="6" />
            <rect x="60" y="140" width="280" height="320" fill="var(--color-paper)" />
          </g>
        )}

        {room.id === 'bathroom' && (
          <g stroke="var(--color-ink)" stroke-width="2" fill="none">
            <rect x="480" y="180" width="300" height="240" rx="90" />
            <rect x="390" y="230" width="140" height="140" fill="var(--color-paper)" />
            <circle cx="460" cy="300" r="60" stroke="var(--color-line)" />
          </g>
        )}

        {room.id === 'hallway' && (
          <g stroke="var(--color-ink)" stroke-width="2" fill="none" stroke-dasharray="4 4">
            <rect x="380" y="80" width="140" height="440" stroke="var(--color-line)" />
          </g>
        )}

        {room.hotspots.map((h) => (
          <g class="hotspot" data-target={h.id} tabindex="0" role="button" aria-label={h.label}>
            <circle cx={h.x} cy={h.y} r="14" class="hotspot-dot" />
            <circle cx={h.x} cy={h.y} r="14" class="hotspot-pulse" />
            <text x={h.x} y={h.y - 24} text-anchor="middle" class="hotspot-label">{h.label}</text>
          </g>
        ))}
      </svg>
    </div>

    {room.hotspots.length === 0 && (
      <p class="mt-6 text-sm" style="color: var(--color-ink-soft);">
        Just passing through — nothing to click here yet.
      </p>
    )}
  </section>

  <!-- overlay + detail panels -->
  <div id="panel-overlay" class="fixed inset-0 z-40 hidden" style="background: rgba(33,29,24,0.4);"></div>
  <aside
    id="panel"
    class="fixed top-0 right-0 z-50 h-full w-full sm:w-[380px] overflow-y-auto panel-slide"
    style="background: var(--color-paper); border-left: 1px solid var(--color-line);"
  >
    <div class="px-6 py-6">
      <button id="panel-close" class="text-sm mb-6" style="color: var(--color-ink-soft);">close ✕</button>
      {room.hotspots.map((h) => (
        <div data-panel={h.id} hidden>
          <h2 class="font-serif text-2xl mb-4" style="color: var(--color-ink);">{h.label}</h2>
          <ul class="space-y-5">
            {h.items.map((item) => (
              <li class="pb-5 border-b" style="border-color: var(--color-line);">
                <p class="font-medium" style="color: var(--color-ink);">{item.title}</p>
                {item.subtitle && (
                  <p class="text-xs mt-0.5" style="color: var(--color-ink-soft);">{item.subtitle}</p>
                )}
                <p class="text-sm mt-2" style="color: var(--color-ink-soft);">{item.note}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </aside>
</Layout>

<style>
  .hotspot {
    cursor: pointer;
  }
  .hotspot-dot {
    fill: var(--color-accent);
    stroke: var(--color-paper);
    stroke-width: 2;
    transition: r 0.15s ease;
  }
  .hotspot-pulse {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0.5;
    animation: pulse 2.2s ease-out infinite;
  }
  .hotspot-label {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--color-ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .hotspot:hover .hotspot-label,
  .hotspot:focus-visible .hotspot-label {
    opacity: 1;
  }
  .hotspot:hover .hotspot-dot,
  .hotspot:focus-visible .hotspot-dot {
    r: 17;
  }
  @keyframes pulse {
    0% { r: 14; opacity: 0.5; }
    100% { r: 26; opacity: 0; }
  }
  .panel-slide {
    transform: translateX(105%);
    transition: transform 0.3s ease-out;
  }
  .panel-slide.open {
    transform: translateX(0);
  }
</style>

<script>
  function initHotspots() {
    const overlay = document.getElementById('panel-overlay');
    const panel = document.getElementById('panel');
    const closeBtn = document.getElementById('panel-close');
    if (!overlay || !panel) return;

    const panels = panel.querySelectorAll<HTMLElement>('[data-panel]');

    function open(id: string) {
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== id;
      });
      overlay!.classList.remove('hidden');
      panel!.classList.add('open');
    }

    function close() {
      overlay!.classList.add('hidden');
      panel!.classList.remove('open');
    }

    document.querySelectorAll<HTMLElement>('.hotspot').forEach((el) => {
      el.addEventListener('click', () => {
        const target = el.dataset.target;
        if (target) open(target);
      });
      el.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          const target = el.dataset.target;
          if (target) open(target);
        }
      });
    });

    overlay.addEventListener('click', close);
    closeBtn?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  initHotspots();
  document.addEventListener('astro:page-load', initHotspots);
</script>
