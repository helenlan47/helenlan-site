---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <section class="max-w-3xl mx-auto px-6 py-24">
    <h1 class="font-serif text-5xl leading-tight" style="color: var(--color-ink);">
      Notes, and a map<br />of the places I love.
    </h1>
    <p class="mt-6 text-lg max-w-xl" style="color: var(--color-ink-soft);">
      A running journal alongside a curated map of favorite restaurants,
      shows, galleries, and gardens — collected as I travel.
    </p>
    <div class="mt-10 flex gap-4 text-sm font-medium">
      <a
        href="/journal"
        class="px-5 py-2.5 rounded-full text-white"
        style="background-color: var(--color-accent);"
      >
        Read the journal
      </a>
      <a
        href="/map"
        class="px-5 py-2.5 rounded-full border"
        style="border-color: var(--color-line); color: var(--color-ink);"
      >
        Explore the map
      </a>
    </div>
  </section>
</Layout>
