---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Journal">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="font-serif text-3xl mb-10" style="color: var(--color-ink);">Journal</h1>
    <ul class="space-y-8">
      {posts.map((post) => (
        <li class="pb-8 border-b" style="border-color: var(--color-line);">
          <a href={`/journal/${post.id}`} class="group block">
            <time
              class="text-sm"
              style="color: var(--color-ink-soft);"
              datetime={post.data.date.toISOString()}
            >
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2
              class="font-serif text-2xl mt-1 group-hover:underline"
              style="color: var(--color-ink);"
            >
              {post.data.title}
            </h2>
            <p class="mt-2" style="color: var(--color-ink-soft);">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
    {posts.length === 0 && (
      <p style="color: var(--color-ink-soft);">No entries yet.</p>
    )}
  </section>
</Layout>
