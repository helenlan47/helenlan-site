---
// Link-preview tags (iMessage, Slack, WhatsApp, LinkedIn, X...). The image
// is a screenshot of the café at public/og-image.png (1200x630); preview
// apps need absolute URLs, hence the hardcoded domain.
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = 'https://helenlan.com';
const image = `${site}/og-image.png`;
---

<meta property="og:type" content="website" />
<meta property="og:site_name" content="helenlan" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={`${site}${Astro.url.pathname}`} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="A pixel-art café with a barista, bookshelf, jukebox and a sleeping cat" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
