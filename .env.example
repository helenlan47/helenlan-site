# Copy to .env and fill in. Mapbox tokens are meant to be public (restrict
# them by URL in your Mapbox account settings), so this is safe to expose
# client-side — that's why it's prefixed PUBLIC_.
PUBLIC_MAPBOX_TOKEN=

# For scripts/sync_notion.py -- an internal Notion integration secret,
# and the ID of the page it's shared with. Not exposed to the browser
# (no PUBLIC_ prefix), only read server-side by the Python script.
NOTION_TOKEN=
NOTION_PAGE_ID=
